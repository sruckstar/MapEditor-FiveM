<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- FiveM's Mono v1 runtime. Mono v2 (.NET 8) uses a different CitizenFX.Core API. -->
    <TargetFramework>net452</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>MapEditor</RootNamespace>
    <!-- The ".net" suffix is what makes FiveM load this as a Mono client script. -->
    <AssemblyName>MapEditor.Client.net</AssemblyName>
    <!-- net452 has no System.ValueTuple, so tuple syntax is out; 7.3 is the highest safe level. -->
    <LangVersion>7.3</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>resource\mapeditor\client\</OutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>MapEditor.Client</AssemblyTitle>
    <Product>MapEditor for FiveM</Product>
    <Version>2.0.0</Version>
    <!-- Only the files listed below compile. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets net452 build without Visual Studio / the targeting pack installed. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />

    <!-- Provided by the FiveM runtime: reference it, never ship it. -->
    <PackageReference Include="CitizenFX.Core.Client" Version="1.0.*">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>

  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>

